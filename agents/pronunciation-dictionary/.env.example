# Copy to .env and fill in. Keep .env out of source control.

# API key from the Inworld Portal (platform.inworld.ai). Paste the Base64
# credential exactly as copied; it's already base64(key_id:secret).
# The key needs write access to the workspace below.
INWORLD_API_KEY=
# ID of the workspace that owns the dictionary, e.g. default-abc123.
INWORLD_WORKSPACE=

# Optional overrides (defaults shown)
# The scripts find the example's dictionary by this display name (1-64 characters).
# INWORLD_DICTIONARY_DISPLAY_NAME=Pronunciation dictionary example
# Voice, model, and language used by `npm run inworld -- preview`.
# Pronunciation dictionaries apply to TTS 2 models only.
# INWORLD_VOICE_ID=Sarah
# INWORLD_MODEL_ID=inworld-tts-2
# INWORLD_LANGUAGE=en-US
# INWORLD_BASE_URL=https://api.inworld.ai

# --- Ultravox (only for `npm run ultravox`) ------------------------------------
# API key from the Ultravox console (https://app.ultravox.ai/settings).
ULTRAVOX_API_KEY=

# A voice added through the Ultravox API uses the Ultravox account's own Inworld
# key, and that key must be able to read the dictionaries. Set to true to store
# INWORLD_API_KEY on the Ultravox account (replaces any Inworld key already there).
ULTRAVOX_SET_INWORLD_KEY=false

# Optional overrides (defaults shown)
# Voice name: letters, digits, _ and - only (no spaces). Also settable with --name.
# ULTRAVOX_VOICE_NAME=sarah-pronunciation-example
# ULTRAVOX_BASE_URL=https://api.ultravox.ai
