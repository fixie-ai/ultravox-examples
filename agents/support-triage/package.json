{
  "name": "support-triage",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local devtools/dev.ts",
    "dev:tools": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local toolServer/index.ts",
    "start:tools": "tsx --env-file-if-exists=.env toolServer/index.ts",
    "dev:web": "vite",
    "agent:sync": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local agent/sync.ts",
    "text-call": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local devtools/text-call.ts",
    "compare": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local devtools/compare.ts",
    "prompts": "tsx devtools/prompts.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hono/node-server": "^2.1.3",
    "@tailwindcss/vite": "^4.1.4",
    "@xyflow/react": "^12.12.0",
    "hono": "^4.13.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "ultravox-client": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cloudflared": "^0.7.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
