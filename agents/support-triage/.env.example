# Copy to .env (or .env.local; both are read, .env.local wins) and fill in.
# Keep these files out of source control.

# --- Required --------------------------------------------------------------------
# Ultravox API key, from https://app.ultravox.ai/settings. Used to save the agent
# (pnpm agent:sync) and, by the developer tools, to start test calls.
ULTRAVOX_API_KEY=

# --- Optional --------------------------------------------------------------------
# Inworld API key for the Jev decision model (Inworld Decisions API), used by the
# tool server. Without it, an offline keyword stand-in (heuristic) decides.
# Paste the Base64 credential from the Inworld Portal as copied. The workspace must
# not have zero data retention turned on.
# INWORLD_API_KEY=

# --- Agent (tool server and agent:sync) -------------------------------------------
# DECISION_PROVIDER=jev          # jev or heuristic; default jev when INWORLD_API_KEY is set
# DECISION_MODEL=typesafe/jev-latest
# INWORLD_BASE_URL=https://api.inworld.ai
# DECISION_CHECK=on              # off skips the decision model
# DECISION_ACCEPT=0.8            # probability to accept (or to prefer another option)
# DECISION_FLOOR=0.5             # a top-ranked option is accepted from this probability
# DECISION_TIMEOUT_MS=600        # continue without the decision model after this long
# AGENT_NAME=acme-support-triage # the saved Ultravox agent (plus -<model> for other models)
# TOOLS_SECRET=                  # the tool server only answers calls with it; pnpm agent:sync gives it to the agent (pnpm dev makes one per run)
# TOOLS_PUBLIC_URL=              # the tool server's public URL, for pnpm agent:sync without --tools-url
# OBSERVER_SECRET=               # signs the observer's forced tool calls (pnpm dev makes one per run)
# OBSERVER_REACTION=speaks-once  # or speaks / listens: the agent's reaction after a call the observer forced
# TOOLS_PORT=8787

# --- Developer tools ------------------------------------------------------------------
# DEVTOOLS_PORT=8788             # the devtools server (local only, on 127.0.0.1)
# DEVTOOLS_WEB_PORT=5173         # the web debugger; pnpm dev fails if it's taken (text-call and compare link to it)
# DEVTOOLS_URL=http://127.0.0.1:8788  # where pnpm text-call and compare reach the devtools server

# Rates for the "Estimated cost" display and pnpm text-call / pnpm compare.
# Set them to your own pricing. (VITE_ so the browser can read them; not secrets.)
# VITE_ULTRAVOX_PRICE_PER_MINUTE=0.05
# VITE_ULTRAVOX_BILLING_INCREMENT_SECONDS=6   # partial increments round up
# VITE_JEV_PRICE_PER_MILLION_INPUT_TOKENS=0.042

# Extra Ultravox models to offer in the debugger's model picker, comma-separated (for models your account can use
# that GET /api/models doesn't list). The scripts' --model flag takes any model name.
# VITE_EXTRA_MODELS=
